{
  "name": "radar-da-voz",
  "version": "1.0.0",
  "description": "Plataforma de economia de talentos - Descoberta, análise e monetização de talentos vocais e criativos",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:db": "jest --testPathPattern=tests/db",
    "e2e": "playwright test",
    "supabase:types": "supabase gen types typescript --local > types/database.types.ts",
    "supabase:up": "supabase start",
    "supabase:down": "supabase stop",
    "db:migrate": "supabase migration create",
    "health-check": "curl -f https://radardevoz.com/api/health",
    "deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next": "14.0.0",
    "@supabase/supabase-js": "^2.38.0",
    "stripe": "^13.0.0",
    "tailwindcss": "3.3.0",
    "typescript": "^5.2.0",
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0",
    "clsx": "^2.0.0",
    "sonner": "^1.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@playwright/test": "^1.41.2",
    "prettier": "^3.1.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.3",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.17",
    "supabase": "^1.159.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
